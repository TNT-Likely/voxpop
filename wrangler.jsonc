/**
 * 众声 VoxPop - Cloudflare Worker 配置
 * 部署前：npx wrangler d1 create voxpop，把 database_id 回填到这里
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxpop",
  "main": "src/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "voxpop.beejz.com", "custom_domain": true }
  ],
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxpop",
      "database_id": "e97ec696-c969-4329-97e5-6f78c20a6b27"
    }
  ],
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_LOGIN",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "SAMPLE_RATE": "1.0",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFpzG4Y9x81SH7Pr"
  },
  "triggers": {
    // 每日 03:17 UTC 聚合 events -> event_daily 并清理 180 天前明细
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // 密钥用 `npx wrangler secret put` 配置：ADMIN_KEY、SERVER_SALT
  // Turnstile（可选）：Dashboard -> Turnstile 免费创建站点（域名填本站两个入口），
  //   然后 `npx wrangler secret put TURNSTILE_SECRET_KEY`，
  //   并把 "TURNSTILE_SITE_KEY": "0x..." 加进上面 vars（未配置即不启用校验）
  // "vars" 里可加 "TURNSTILE_SITE_KEY": "0x..."
  // 自定义域名（免费）：dashboard 绑定，如 voxpop.beejz.com
}
