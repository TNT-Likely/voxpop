/**
 * 众声 VoxPop - Cloudflare Worker 配置
 * 部署前：npx wrangler d1 create voxpop，把 database_id 回填到这里
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxpop",
  "main": "src/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "voxpop.beejz.com", "custom_domain": true }
  ],
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxpop",
      "database_id": "e97ec696-c969-4329-97e5-6f78c20a6b27"
    }
  ],
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "SAMPLE_RATE": "1.0"
  },
  "observability": {
    "enabled": true
  }
  // 密钥用 `npx wrangler secret put` 配置：ADMIN_KEY、SERVER_SALT
  // 可选：TURNSTILE_SECRET_KEY（配置后自动启用投票人机校验），站点 key 填到下面 vars
  // "vars" 里可加 "TURNSTILE_SITE_KEY": "0x..."
  // 自定义域名（免费）：dashboard 绑定，如 voxpop.beejz.com
}
